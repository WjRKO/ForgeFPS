# Copia in .env e riempi. NON committare .env (e' gia' in .gitignore).
# Inventario estratto dal codice: vedi docs/MIGRAZIONE_DA_EMERGENT.md.

# --- Obbligatorie: senza queste il backend non parte ---
# In docker-compose MONGO_URL e DB_NAME sono gia' impostate dal servizio.
MONGO_URL=mongodb://localhost:27017
DB_NAME=forgefps
# Se cambia, tutte le sessioni utente attive decadono.
JWT_SECRET=
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Account admin creato al primo avvio ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Motore AI ---
# Finche' LLM_PROVIDER resta "emergent" serve la chiave della vecchia
# piattaforma. Vedi backend/llm/__init__.py per aggiungerne un altro.
LLM_PROVIDER=emergent
EMERGENT_LLM_KEY=

# --- Pagamenti ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
SENDER_EMAIL=
REPLY_TO_EMAIL=
APP_ORIGIN=http://localhost:3000

# --- Notifiche push ---
# Se queste chiavi cambiano, tutte le iscrizioni push esistenti smettono di
# funzionare e gli utenti devono riattivarle.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Discord (opzionale) ---
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ROLE_PRO=
DISCORD_ROLE_BOOSTED_ID=
DISCORD_ROLE_CREATOR_VERIFIED=
DISCORD_CHANNEL_CREATOR_REVIEW=
DISCORD_WEBHOOK_FEEDBACK=
DISCORD_REDIRECT_URI=

# --- Annunci release su Discord ---
# Spento per default. Accendere SOLO nell'ambiente di produzione definitivo,
# altrimenti gli annunci partono due volte durante la convivenza dei due
# ambienti.
RELEASE_ANNOUNCER_ENABLED=false
