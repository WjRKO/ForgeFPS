# Copia in .env e riempi. NON committare .env (e' gia' in .gitignore).
# Inventario estratto dal codice: vedi docs/MIGRAZIONE_DA_EMERGENT.md.

# --- Obbligatorie: senza queste il backend non parte ---
# In docker-compose MONGO_URL e DB_NAME sono gia' impostate dal servizio.
MONGO_URL=mongodb://localhost:27017
DB_NAME=forgefps
# Se cambia, tutte le sessioni utente attive decadono.
JWT_SECRET=
FRONTEND_URL=http://localhost:3000
# Solo se front-end e API NON stanno sullo stesso dominio (es. in locale,
# 3000 e 8001). E' l'URL che finisce nel .bat generato per l'agent desktop:
# se vuota si usa FRONTEND_URL, che in produzione e' corretto.
AGENT_BACKEND_URL=
CORS_ORIGINS=http://localhost:3000

# --- Account admin creato al primo avvio ---
# ADMIN_PASSWORD serve solo alla creazione. Se poi la cambi dall'interfaccia,
# il valore qui resta indietro ma NON viene piu' riapplicato: puoi svuotare la
# riga, cosi' non tieni una password in chiaro su disco.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Paracadute: se perdi la password admin, rimetti il valore in ADMIN_PASSWORD e
# avvia UNA volta con questa a 1. Al riavvio successivo rimuovila, altrimenti
# ogni avvio annulla i cambi password fatti dall'app.
ADMIN_PASSWORD_RESET=

# --- Motore AI ---
# Provider attivo: "anthropic" (Claude API, SDK ufficiale). Per aggiungerne
# altri vedi backend/llm/__init__.py: un file nel package piu' una riga in
# _PROVIDERS, nessun altro punto del backend va toccato.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Opzionali. Il default e' claude-haiku-4-5 con 4096 token di output.
# Gli identificativi vanno esatti e senza suffisso di data.
ANTHROPIC_MODEL=
ANTHROPIC_MAX_TOKENS=
# Solo per il vecchio provider "emergent", non piu' installabile.
EMERGENT_LLM_KEY=

# --- Pagamenti ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
SENDER_EMAIL=
REPLY_TO_EMAIL=
APP_ORIGIN=http://localhost:3000

# --- Notifiche push ---
# Se queste chiavi cambiano, tutte le iscrizioni push esistenti smettono di
# funzionare e gli utenti devono riattivarle.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Discord (opzionale) ---
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ROLE_PRO=
DISCORD_ROLE_BOOSTED_ID=
DISCORD_ROLE_CREATOR_VERIFIED=
DISCORD_CHANNEL_CREATOR_REVIEW=
DISCORD_WEBHOOK_FEEDBACK=
DISCORD_REDIRECT_URI=

# --- Annunci release su Discord ---
# Spento per default. Accendere SOLO nell'ambiente di produzione definitivo,
# altrimenti gli annunci partono due volte durante la convivenza dei due
# ambienti.
RELEASE_ANNOUNCER_ENABLED=false
